loki.source.file "bili_notify" {
  targets = [
    {
      __path__ = "/bili-data/logs/bili-notify.jsonl",
      job      = "bili-notify",
    },
  ]
  tail_from_end = false
  forward_to    = [loki.process.bili_notify.receiver]
}

loki.process "bili_notify" {
  stage.json {
    expressions = {
      timestamp = "time",
      service   = "service",
      category  = "category",
      level     = "level",
      component = "component",
    }
  }

  stage.timestamp {
    source = "timestamp"
    format = "RFC3339Nano"
  }

  stage.labels {
    values = {
      service   = "",
      category  = "",
      level     = "",
      component = "",
    }
  }

  forward_to = [loki.write.bili_notify.receiver]
}

loki.write "bili_notify" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
