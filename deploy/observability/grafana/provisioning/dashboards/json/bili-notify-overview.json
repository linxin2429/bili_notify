{
  "annotations": { "list": [] },
  "editable": false,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "bili-notify-prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "bili_notify_ready", "refId": "A" }],
      "title": "Ready",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "bili-notify-prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "bili_notify_auth_valid", "refId": "A" }],
      "title": "Bilibili session valid",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "bili-notify-prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "bili_notify_outbox_pending + bili_notify_outbox_blocked", "refId": "A" }],
      "title": "Outbox depth",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "bili-notify-prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "bili_notify_outbox_oldest_age_seconds", "refId": "A" }],
      "title": "Oldest delivery age",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "bili-notify-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "id": 5,
      "targets": [{ "expr": "sum by (workflow, result) (rate(bili_notify_workflow_runs_total[$__rate_interval]))", "legendFormat": "{{workflow}} {{result}}", "refId": "A" }],
      "title": "Workflow run rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "bili-notify-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "id": 6,
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, workflow) (rate(bili_notify_workflow_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p95 {{workflow}}", "refId": "A" }],
      "title": "Workflow p95 duration",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "bili-notify-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "id": 7,
      "targets": [{ "expr": "sum by (notification_channel_type, result) (rate(bili_notify_notification_delivery_attempts_total[$__rate_interval]))", "legendFormat": "{{notification_channel_type}} {{result}}", "refId": "A" }],
      "title": "Notification delivery rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "bili-notify-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "id": 8,
      "targets": [{ "expr": "sum by (result) (rate(bili_notify_bilibili_requests_total[$__rate_interval]))", "legendFormat": "{{result}}", "refId": "A" }],
      "title": "Bilibili request rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "bili-notify-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
      "id": 9,
      "targets": [{ "expr": "sum by (job_kind, result) (rate(bili_notify_ai_worker_jobs_total[$__rate_interval]))", "legendFormat": "{{job_kind}} {{result}}", "refId": "A" }],
      "title": "AI Worker job rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "bili-notify-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 },
      "id": 10,
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, job_kind) (rate(bili_notify_ai_worker_job_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p95 {{job_kind}}", "refId": "A" }],
      "title": "AI Worker job p95 duration",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "bili-notify-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 29
      },
      "id": 11,
      "title": "Bilibili session maintenance outcomes",
      "type": "stat",
      "description": "Cumulative maintenance outcomes for the current processes; counters reset on restart. renewed includes durable confirmation, confirmed resumes a previous renewal. not_due, requires_login, error, skipped and canceled are separate outcomes.",
      "targets": [
        {
          "expr": "sum by (result) (bili_notify_workflow_runs_total{platform=\"bilibili\",workflow=\"session_maintenance\"})",
          "legendFormat": "{{result}}",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "bili-notify-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 29
      },
      "id": 12,
      "title": "Bilibili session maintenance p95 duration",
      "type": "timeseries",
      "description": "A one-hour window includes multiple ten-minute maintenance cycles. Skipped and canceled cycles are excluded.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(bili_notify_workflow_duration_seconds_bucket{platform=\"bilibili\",workflow=\"session_maintenance\",result!~\"skipped|canceled\"}[1h])))",
          "legendFormat": "p95 maintenance",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "15s",
  "schemaVersion": 41,
  "tags": ["bili-notify", "operations"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
