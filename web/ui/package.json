{
  "name": "bili-notify-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api:generate": "npm run api:lint && openapi-typescript ../../api/openapi.yaml --output src/shared/api/generated/schema.d.ts",
    "api:lint": "redocly lint ../../api/openapi.yaml --config ../../api/redocly.yaml",
    "api:check": "node scripts/check-openapi-generated.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint src scripts eslint.config.js vite.config.ts playwright.config.ts test-workers.ts --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:run": "playwright test",
    "build": "tsc -b && vite build",
    "bundle:check": "node scripts/check-bundle-budget.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@tanstack/react-query": "5.101.4",
    "lucide-react": "1.31.0",
    "react": "19.2.0",
    "react-aria": "3.51.0",
    "react-dom": "19.2.0",
    "react-router-dom": "7.18.2",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@babel/core": "7.29.7",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.55.1",
    "@redocly/cli": "2.46.0",
    "@rolldown/plugin-babel": "0.2.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/babel__core": "7.20.5",
    "@types/node": "24.13.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.8.1",
    "eslint-plugin-boundaries": "7.1.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.9.0",
    "jsdom": "27.4.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "overrides": {
    "js-yaml": "4.3.1"
  }
}
